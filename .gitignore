# ─── C# build outputs ────────────────────────────────────────────────────────
bin/
obj/
*.user

# ─── Data (large, re-generable) ──────────────────────────────────────────────
# Raw API price files (re-downloadable via `dotnet run -- download`)
data/raw/
# Simulation output (re-producible via `dotnet run -- simulate`)
data/lots.csv
data/lots-mc.csv
# ML artifacts (re-producible via `dotnet run -- ml-*`)
data/artifacts/

# ─── ML/Python build outputs ─────────────────────────────────────────────────
# uv virtualenv
src/ML/Python/.venv/
# pytest cache
src/ML/Python/.pytest_cache/
# Python bytecode
**/__pycache__/
*.pyc
# Build dist
src/ML/Python/dist/
src/ML/Python/build/
*.egg-info/

# ─── Export (re-generable plots) ─────────────────────────────────────────────
# Keep the directories tracked via .gitkeep but ignore PNG outputs;
# they're regenerated by the EDA / model scripts.
src/Export/eda/*.png
src/Export/eda/*.json
src/Export/models/*.png

# ─── Secrets ─────────────────────────────────────────────────────────────────
.env
*.env

# ─── macOS metadata ──────────────────────────────────────────────────────────
.DS_Store
**/.DS_Store
